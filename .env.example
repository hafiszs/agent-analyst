# --- LLM (any OpenAI-compatible endpoint) ---
# Development: Azure OpenAI v1 endpoint
LLM_BASE_URL=https://YOUR-RESOURCE.openai.azure.com/openai/v1/
LLM_API_KEY=
LLM_MODEL=your-deployment-name
# Final submission (required by the hackathon): Vultr Serverless Inference
# LLM_BASE_URL=https://api.vultrinference.com/v1
# LLM_API_KEY=<vultr inference key>
# LLM_MODEL=<model name from the Vultr live model list>

# --- Sandbox limits (per execution) ---
SANDBOX_IMAGE=agent-sandbox:latest
SANDBOX_MEMORY_MB=512
SANDBOX_CPUS=1.0
SANDBOX_TIMEOUT_S=30
SANDBOX_PIDS=128
SANDBOX_OUTPUT_MB=100

# --- Agent / API ---
MAX_RETRIES=4
MAX_UPLOAD_MB=10
MAX_CONCURRENT_JOBS=2
JOB_TTL_S=3600
CORS_ORIGINS=*
